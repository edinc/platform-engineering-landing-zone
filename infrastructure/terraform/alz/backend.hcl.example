# Backend configuration for the alz stack's state.
#
# Copy to backend.hcl (gitignored) and pass with:
#   terraform init -backend-config=backend.hcl
#
# resource_group_name and storage_account_name come from the _bootstrap stack
# outputs (resource_group_name, state_storage_account_name). The "alz" container
# is provisioned by _bootstrap. State access is Entra-ID-only (no storage keys).

resource_group_name  = "rg-pe-tfstate-weu"
storage_account_name = "stpetfweuab12" # stpetf<location_short><name_suffix> from _bootstrap
container_name       = "alz"
key                  = "alz.tfstate"
use_azuread_auth     = true
