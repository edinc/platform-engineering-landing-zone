# Example inputs for the Stage 03 connectivity stack. Copy to terraform.tfvars
# (gitignored) and fill tenant-specific values. Never commit real tenant IDs.

tenant_id       = "00000000-0000-0000-0000-000000000000"
subscription_id = "33333333-3333-3333-3333-333333333333"

profile        = "nonprod"
location       = "westeurope"
location_short = "weu"

hub_vnet_address_space = ["10.20.0.0/16"]
subnet_address_prefixes = {
  GatewaySubnet        = "10.20.0.0/27"
  AzureFirewallSubnet  = "10.20.1.0/26"
  private-endpoints    = "10.20.2.0/24"
  shared-services      = "10.20.3.0/24"
}

# Non-demo profiles use Azure Firewall Premium and the curated allowlist in
# policies/azure/firewall/allowlist.json. Set a workspace to enable firewall
# policy insights.
# firewall_base_policy_id = "/subscriptions/33333333-3333-3333-3333-333333333333/resourceGroups/rg-alz-connectivity/providers/Microsoft.Network/firewallPolicies/afwp-alz-parent-weu"
# log_analytics_workspace_id = "/subscriptions/22222222-2222-2222-2222-222222222222/resourceGroups/rg-platform-monitoring/providers/Microsoft.OperationalInsights/workspaces/log-platform-weu"

# Enable AMPLS only when at least one scoped monitor resource is known, so
# Private DNS does not route traffic to an empty Private Link Scope.
enable_monitor_private_link_scope = true
monitor_linked_resource_ids = [
  "/subscriptions/22222222-2222-2222-2222-222222222222/resourceGroups/rg-platform-monitoring/providers/Microsoft.OperationalInsights/workspaces/log-platform-weu"
]

# Link every created Private DNS zone to brownfield spokes as they are onboarded.
# spoke_virtual_network_ids = {
#   app1-nonprod = "/subscriptions/55555555-5555-5555-5555-555555555555/resourceGroups/rg-app1-net/providers/Microsoft.Network/virtualNetworks/vnet-app1-nonprod-weu"
# }

# Stage 01 Phase-2 retrofit examples: move remote state and seed Key Vault behind
# Private Endpoints after this hub exists, then disable public network access in
# the _bootstrap stack.
# private_endpoints = {
#   tfstate-blob = {
#     resource_id            = "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/rg-pe-bootstrap-weu/providers/Microsoft.Storage/storageAccounts/stpebootweu0000"
#     subresource_names      = ["blob"]
#     private_dns_zone_names = ["privatelink.blob.core.windows.net"]
#   }
#   seed-kv = {
#     resource_id            = "/subscriptions/11111111-1111-1111-1111-111111111111/resourceGroups/rg-pe-bootstrap-weu/providers/Microsoft.KeyVault/vaults/kv-pe-boot-weu-0000"
#     subresource_names      = ["vault"]
#     private_dns_zone_names = ["privatelink.vaultcore.azure.net"]
#   }
# }

owner       = "platform-engineering"
cost_center = "cc-platform"
github_owner = "edinc"
github_repo  = "platform-engineering-landing-zone"
