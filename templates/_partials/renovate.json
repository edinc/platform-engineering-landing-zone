{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies",
    "golden-path"
  ],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchManagers": [
        "github-actions",
        "dockerfile",
        "helm-values",
        "terraform"
      ],
      "automerge": false
    }
  ]
}
