---
import Layout from "../layouts/Layout.astro";
import { withBase } from "../lib/base";
---

<Layout title="Page not found" path="/404">
  <section class="nf">
    <div class="container nf__inner">
      <p class="nf__code mono">404</p>
      <h1>This path isn't paved yet</h1>
      <p class="nf__lead section-lead">
        The page you're after doesn't exist. Head back to the guide, or jump
        straight to the architecture explorer.
      </p>
      <div class="nf__cta">
        <a class="btn btn--primary" href={withBase("/")}>Back to the guide</a>
        <a class="btn btn--ghost" href={withBase("/#architecture")}>Architecture explorer</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .nf {
    min-height: 60vh;
    display: grid;
    place-items: center;
    padding-block: var(--section-y);
  }
  .nf__inner {
    text-align: center;
    max-width: 40rem;
  }
  .nf__code {
    font-size: 3rem;
    font-weight: var(--w-bold);
    color: var(--accent);
    letter-spacing: 0.05em;
  }
  .nf h1 {
    margin-top: var(--s-sm);
    font-size: var(--text-h2);
  }
  .nf__lead {
    margin-top: var(--s-md);
    margin-inline: auto;
  }
  .nf__cta {
    margin-top: var(--s-lg);
    display: flex;
    gap: var(--s-xs);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
