---
import { withBase, REPO, repoPath } from "../lib/base";
import Icon from "./Icon.astro";
---

<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow reveal" style="--i:0">
        <span class="eyebrow__dot" aria-hidden="true"></span> An interactive guide to platform
        engineering
      </p>
      <h1 class="hero__title reveal" style="--i:1">
        The paved road from <span class="hero__mono">commit</span> to a running, governed
        service.
      </h1>
      <p class="hero__lead reveal" style="--i:2">
        Platform engineering turns hard-won Azure, Kubernetes and supply-chain
        decisions into golden paths, so developers ship without carrying the whole
        cloud in their head. This is a tour of those ideas, built on a real,
        opinionated Internal Developer Platform that proves each one.
      </p>
      <div class="hero__cta reveal" style="--i:3">
        <a class="btn btn--primary" href={withBase("/#architecture")}>
          Explore the architecture
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn btn--ghost" href={repoPath("docs/how-it-works/README.md")} target="_blank" rel="noopener">
          Read the docs
        </a>
        <a class="btn btn--quiet" href={REPO} target="_blank" rel="noopener">
          <Icon name="github" size={17} /> GitHub
        </a>
      </div>
      <p class="hero__meta reveal mono" style="--i:4">
        Internal Developer Platform · Azure · GitOps · secure by default · WCAG&nbsp;AA
      </p>
    </div>

    <figure class="hero__figure reveal" style="--i:3">
      <svg
        class="schematic"
        viewBox="0 0 480 528"
        role="img"
        aria-label="Schematic: GitHub authenticates to the platform subscription with OIDC and no stored secrets. Inside, a private AKS cluster, container registry, Key Vault and Postgres. Flux reconciles GitOps state into vended team namespaces, and everything reports to Azure Monitor, Defender and Cost Management."
      >
        <defs>
          <linearGradient id="flow" x1="0" y1="0" x2="1" y2="0">
            <stop offset="0" stop-color="var(--accent)" stop-opacity="0"></stop>
            <stop offset="0.5" stop-color="var(--accent)"></stop>
            <stop offset="1" stop-color="var(--accent)" stop-opacity="0"></stop>
          </linearGradient>
        </defs>

        <!-- wires (behind nodes) -->
        <g class="wires" aria-hidden="true" fill="none" stroke="var(--hairline-strong)" stroke-width="1.5">
          <path d="M240 86 L240 140" />
          <path d="M138 260 L138 408" />
          <path d="M224 437 L252 437" />
          <path d="M138 468 L138 488" />
          <path d="M356 468 L356 488" />
        </g>
        <!-- animated golden-path flow -->
        <g class="flows" aria-hidden="true" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round">
          <path class="flow" d="M240 86 L240 140" />
          <path class="flow flow--2" d="M138 260 L138 408" />
          <path class="flow flow--3" d="M224 437 L252 437" />
        </g>

        <!-- GitHub -->
        <g class="node">
          <rect x="40" y="22" width="400" height="64" rx="11" />
          <text class="t-title" x="64" y="50">GitHub</text>
          <text class="t-sub" x="64" y="70">reusable workflows · OIDC · cosign · SBOM</text>
        </g>
        <text class="t-wire" x="250" y="118">OIDC · no secrets</text>

        <!-- Platform subscription container -->
        <g class="frame">
          <rect x="24" y="140" width="432" height="232" rx="14" />
          <text class="t-frame" x="42" y="162">Platform subscription</text>
        </g>

        <!-- AKS (the heart) -->
        <g class="node node--accent">
          <rect x="44" y="180" width="188" height="80" rx="10" />
          <text class="t-title" x="62" y="212">Private AKS</text>
          <text class="t-sub" x="62" y="232">Workload Identity</text>
        </g>
        <!-- ACR -->
        <g class="node">
          <rect x="248" y="180" width="188" height="80" rx="10" />
          <text class="t-title" x="266" y="212">ACR</text>
          <text class="t-sub" x="266" y="232">signed images</text>
        </g>
        <!-- Key Vault -->
        <g class="node">
          <rect x="44" y="276" width="188" height="78" rx="10" />
          <text class="t-title" x="62" y="307">Key Vault</text>
          <text class="t-sub" x="62" y="327">Private Link</text>
        </g>
        <!-- Postgres -->
        <g class="node">
          <rect x="248" y="276" width="188" height="78" rx="10" />
          <text class="t-title" x="266" y="307">Postgres</text>
          <text class="t-sub" x="266" y="327">HA · PITR</text>
        </g>

        <!-- Flux -->
        <g class="node">
          <rect x="44" y="408" width="180" height="58" rx="10" />
          <text class="t-title" x="62" y="434">Flux</text>
          <text class="t-sub" x="62" y="452">GitOps reconcile</text>
        </g>
        <!-- Namespaces -->
        <g class="node">
          <rect x="252" y="408" width="204" height="58" rx="10" />
          <text class="t-title" x="270" y="434">Vended namespaces</text>
          <g class="chips" transform="translate(270, 446)">
            <rect class="chip" x="0" y="0" width="34" height="12" rx="3" />
            <rect class="chip" x="40" y="0" width="34" height="12" rx="3" />
            <rect class="chip" x="80" y="0" width="34" height="12" rx="3" />
          </g>
        </g>

        <!-- Monitor bar -->
        <g class="bar">
          <rect x="24" y="488" width="432" height="32" rx="9" />
          <text class="t-bar" x="240" y="508">Azure Monitor · Defender · Cost Management</text>
        </g>

        <!-- service logos (brand marks where they exist; monochrome glyphs for Azure-native) -->
        <g class="logos" aria-hidden="true">
          <g transform="translate(392,40) scale(1.167)" fill="var(--ink)">
            <path
              d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"
