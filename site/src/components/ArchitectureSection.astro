---
import ArchitectureExplorer from "../islands/ArchitectureExplorer.svelte";
---

<section class="section arch-section" id="architecture">
  <div class="container">
    <header class="arch-section__head">
      <h2>Architecture explorer</h2>
      <p class="section-lead">
        The platform is a stack of capabilities, each depending on the ones
        below. Select a layer to see what it is, why it's there, who owns it, and
        the decision record behind it.
      </p>
      <p class="arch-section__hint mono" aria-hidden="true">
        ↕ arrow keys to move through layers
      </p>
    </header>
    <ArchitectureExplorer client:visible />
  </div>
</section>

<style>
  .arch-section {
    padding-block: var(--section-y);
    background: var(--surface);
    border-block: var(--hair) solid var(--hairline);
  }
  .arch-section__head {
    max-width: 56rem;
  }
  .arch-section__head h2 {
    font-size: var(--text-h2);
  }
  .arch-section__head .section-lead {
    margin-top: var(--s-md);
  }
  .arch-section__hint {
    margin-top: var(--s-sm);
    font-size: var(--text-sm);
    color: var(--faint);
  }
</style>
