---
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 32 32"
  aria-hidden="true"
  focusable="false"
>
  <path d="M16 18.5 L5.5 13.25 L16 8 L26.5 13.25 Z" fill="var(--accent)"></path>
  <path d="M16 23.75 L5.5 18.5 L16 13.25 L26.5 18.5 Z" fill="var(--accent)" fill-opacity="0.5"
  ></path>
  <circle cx="16" cy="13.25" r="1.7" fill="var(--bg)"></circle>
</svg>
