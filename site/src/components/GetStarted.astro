---
import { REPO, repoPath } from "../lib/base";
import Icon from "./Icon.astro";

const steps = [
  {
    title: "Read how it works",
    desc: "Eleven guides covering each capability end to end.",
    href: repoPath("docs/how-it-works/README.md"),
  },
  {
    title: "Browse the golden paths",
    desc: "The three Backstage templates and what they scaffold.",
    href: repoPath("templates"),
  },
  {
    title: "Read the decisions",
    desc: "Fifty-plus ADRs recording the trade-offs behind the design.",
    href: repoPath("docs/adr/README.md"),
  },
];
---

<section class="section start" id="start">
  <div class="container">
    <div class="start__band">
      <div class="start__lead">
        <h2>Bring the paved road to your tenant</h2>
        <p>
          This whole site is the front door. The platform itself, its Terraform,
          policies, workflows and Backstage templates, lives in the open. Stand it
          up on a subscription beneath your existing Azure Landing Zone.
        </p>
        <div class="start__cta">
          <a class="btn btn--primary" href={REPO} target="_blank" rel="noopener">
            <Icon name="github" size={18} /> View on GitHub
          </a>
          <a class="btn btn--ghost" href={repoPath("README.md")} target="_blank" rel="noopener">
            Read the overview
            <Icon name="arrow-up-right" size={16} />
          </a>
        </div>
      </div>

      <ul role="list" class="start__steps">
        {
          steps.map((s) => (
            <li>
              <a class="start__step" href={s.href} target="_blank" rel="noopener">
                <span class="start__step-text">
                  <span class="start__step-title">{s.title}</span>
                  <span class="start__step-desc">{s.desc}</span>
                </span>
                <Icon name="arrow-up-right" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .start {
    padding-block: var(--section-y);
  }
  .start__band {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    padding: clamp(2rem, 1.5rem + 3vw, 3.5rem);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 140% at 0% 0%, var(--accent-wash), transparent 60%),
      var(--surface);
    border: var(--hair) solid var(--hairline);
  }
  .start__lead h2 {
    font-size: var(--text-h2);
    max-width: 16ch;
  }
  .start__lead p {
    margin-top: var(--s-md);
    color: var(--muted);
    max-width: 46ch;
    font-size: 1.05rem;
    line-height: 1.55;
  }
  .start__cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-xs);
    margin-top: var(--s-lg);
  }
  .start__steps {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    align-self: center;
  }
  .start__step {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-md);
    padding: 1.1rem 1.25rem;
    border-radius: var(--radius);
    background: var(--bg);
    border: var(--hair) solid var(--hairline);
    color: var(--ink);
    transition:
      border-color var(--dur-1) var(--ease-out-quart),
      transform var(--dur-1) var(--ease-out-quart),
      box-shadow var(--dur-2) var(--ease-out-quart);
  }
  .start__step:hover {
    text-decoration: none;
    border-color: var(--accent);
    transform: translateX(3px);
    box-shadow: var(--shadow-sm);
  }
  .start__step :global(svg) {
    color: var(--faint);
    flex: 0 0 auto;
    transition: color var(--dur-1) var(--ease-out-quart);
  }
  .start__step:hover :global(svg) {
    color: var(--accent-deep);
  }
  .start__step-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .start__step-title {
    font-weight: var(--w-semibold);
  }
  .start__step-desc {
    font-size: 0.88rem;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .start__band {
      grid-template-columns: 1fr;
    }
  }
</style>
