{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.example.io/contracts/team-onboarding-request.schema.json",
  "title": "Platform team onboarding request",
  "description": "Versioned Stage 10 contract for app-team identity, GitHub team, and namespace onboarding metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "type": "string",
      "enum": ["platform.example.io/v1alpha1"]
    },
    "kind": {
      "type": "string",
      "enum": ["TeamOnboardingRequest"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "$ref": "#/definitions/slug"
        },
        "labels": {
          "$ref": "#/definitions/labels"
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "team",
        "product",
        "costCenter",
        "onCallRotationId",
        "githubTeam",
        "dataClassification",
        "environments",
        "regions",
        "github",
        "namespace"
      ],
      "properties": {
        "team": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$"
        },
        "product": {
          "type": "string",
          "maxLength": 22,
          "pattern": "^[a-z0-9][a-z0-9-]{1,20}[a-z0-9]$"
        },
        "costCenter": {
          "type": "string",
          "pattern": "^cc-[a-z0-9-]{2,32}$"
        },
        "onCallRotationId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{1,126}[A-Za-z0-9]$"
        },
        "githubTeam": {
          "type": "string",
          "description": "Must equal app-team-<spec.team>; enforced by the workflow validator.",
          "pattern": "^app-team-[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$"
        },
        "dataClassification": {
          "type": "string",
          "enum": ["public", "internal", "confidential", "restricted"]
        },
        "environments": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["demo", "nonprod", "prod"]
          }
        },
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z]+[a-z0-9]+$"
          }
        },
        "github": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner"],
          "properties": {
            "owner": {
              "type": "string",
              "const": "edinc"
            },
            "repositoryPermissions": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "enum": ["pull", "triage"]
              },
              "propertyNames": {
                "pattern": "^[A-Za-z0-9_.-]+$"
              },
              "default": {}
            }
          }
        },
        "namespace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serviceAccountName", "resourceQuota", "egressAllowlist"],
          "properties": {
            "serviceAccountName": {
              "$ref": "#/definitions/slug"
            },
            "resourceQuota": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cpuRequests", "memoryRequests", "cpuLimits", "memoryLimits", "pods"],
              "properties": {
                "cpuRequests": {
                  "type": "string",
                  "pattern": "^[0-9]+m?$"
                },
                "memoryRequests": {
                  "type": "string",
                  "pattern": "^[0-9]+(Mi|Gi)$"
                },
                "cpuLimits": {
                  "type": "string",
                  "pattern": "^[0-9]+m?$"
                },
                "memoryLimits": {
                  "type": "string",
                  "pattern": "^[0-9]+(Mi|Gi)$"
                },
                "pods": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 500
                }
              }
            },
            "egressAllowlist": {
              "type": "object",
              "additionalProperties": false,
              "required": ["cidrs"],
              "properties": {
                "cidrs": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^(10\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|172\\.(1[6-9]|2[0-9]|3[0-1])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])|192\\.168\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9]))\\/(1[6-9]|2[0-9]|3[0-2])$"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
    },
    "labels": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 63
      }
    }
  }
}
