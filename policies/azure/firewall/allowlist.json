{
  "version": "2026-06-10",
  "description": "Curated Azure Firewall Premium egress allowlist for connectivity & egress. Unmatched outbound traffic is denied by policy.",
  "application_rule_collections": [
    {
      "name": "platform-control-plane",
      "priority": 100,
      "action": "Allow",
      "rules": [
        {
          "name": "azure-control-plane",
          "destination_fqdns": [
            "management.azure.com",
            "login.microsoftonline.com",
            "graph.microsoft.com"
          ],
          "protocols": [
            {
              "type": "Https",
              "port": 443
            }
          ]
        }
      ]
    },
    {
      "name": "container-registries",
      "priority": 110,
      "action": "Allow",
      "rules": [
        {
          "name": "azure-and-public-registries",
          "destination_fqdns": [
            "mcr.microsoft.com",
            "*.data.mcr.microsoft.com",
            "ghcr.io",
            "pkg-containers.githubusercontent.com",
            "registry-1.docker.io",
            "auth.docker.io",
            "production.cloudflare.docker.com"
          ],
          "protocols": [
            {
              "type": "Https",
              "port": 443
            }
          ]
        }
      ]
    },
    {
      "name": "source-and-package-ecosystems",
      "priority": 120,
      "action": "Allow",
      "rules": [
        {
          "name": "github-and-package-managers",
          "destination_fqdns": [
            "github.com",
            "api.github.com",
            "objects.githubusercontent.com",
            "raw.githubusercontent.com",
            "codeload.github.com",
            "registry.npmjs.org",
            "pypi.org",
            "files.pythonhosted.org",
            "archive.ubuntu.com",
            "security.ubuntu.com"
          ],
          "protocols": [
            {
              "type": "Https",
              "port": 443
            }
          ]
        }
      ]
    },
    {
      "name": "sigstore",
      "priority": 130,
      "action": "Allow",
      "rules": [
        {
          "name": "keyless-signing-and-transparency",
          "destination_fqdns": [
            "rekor.sigstore.dev",
            "fulcio.sigstore.dev",
            "tuf.sigstore.dev",
            "oauth2.sigstore.dev"
          ],
          "protocols": [
            {
              "type": "Https",
              "port": 443
            }
          ]
        }
      ]
    }
  ],
  "network_rule_collections": [
    {
      "name": "azure-platform-network",
      "priority": 200,
      "action": "Allow",
      "rules": [
        {
          "name": "azure-dns",
          "destination_addresses": [
            "168.63.129.16"
          ],
          "destination_ports": [
            "53"
          ],
          "protocols": [
            "TCP",
            "UDP"
          ]
        }
      ]
    }
  ]
}
